# ==============================================
# MATRIX WEAPON DETECTION SYSTEM — Backend ENV
# ==============================================

# Path to the trained YOLOv8 model
# Relative to the backend/ directory or absolute path
MODEL_PATH=../models/best.pt

# CORS origins (comma-separated for multiple)
# Development: http://localhost:5173
# Production: https://your-frontend.netlify.app
CORS_ORIGINS=http://localhost:5173

# Max upload sizes (in megabytes)
MAX_IMAGE_SIZE_MB=10
MAX_VIDEO_SIZE_MB=500

# Output directory for annotated images/frames
OUTPUT_DIR=outputs

# Upload directory for temporary files
UPLOAD_DIR=uploads

# Confidence threshold for detections (0.0 - 1.0)
CONFIDENCE_THRESHOLD=0.25
